{
  "name": "vendor-management-server",
  "version": "1.0.0",
  "description": "Backend API for the Vendor Management System final year project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node db/setup.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/setup.js && node db/seed.js",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "vendor-management",
    "marketplace",
    "ghana",
    "final-year-project"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
